{
  "name": "generic-pcs",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "postbuild": "opennextjs-cloudflare build --skipNextBuild",
    "build:next": "next build",
    "start": "next start",
    "lint": "eslint",
    "deploy": "npm run build && opennextjs-cloudflare deploy",
    "preview": "npm run build && opennextjs-cloudflare preview",
    "typecheck": "tsc --noEmit",
    "typecheck:worker": "tsc --noEmit -p worker/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@fontsource-variable/oxanium": "^5.3.0",
    "@iconify-json/logos": "^1.2.19",
    "@iconify-json/mdi": "^1.2.3",
    "@iconify-json/simple-icons": "^1.2.101",
    "@iconify/react": "^6.0.4",
    "firebase": "^12.19.0",
    "firebase-admin": "^14.5.1",
    "next": "16.4.5",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.8.71",
    "@opennextjs/cloudflare": "^1.20.17",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^3.2.7",
    "wrangler": "^4.162.0"
  }
}
